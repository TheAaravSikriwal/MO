{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // No "node" here on purpose. These files are compiled as browser code, so
    // `process` and `Buffer` must not typecheck. The files that do run in node
    // are listed in tsconfig.node.json.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "api", "shared", "vitest.setup.ts"],
  // Compiled by tsconfig.node.json instead. They read migration SQL off disk,
  // which is node-only by nature.
  "exclude": [
    "src/lib/db/migrations.test.ts",
    "src/lib/db/migrations.run.test.ts",
    "src/lib/db/pgHarness.ts",
    "src/lib/db/pinPhotos.run.test.ts",
    "src/lib/db/cleanup.run.test.ts",
    "src/components/map/CellLayer.test.tsx"
  ]
}
